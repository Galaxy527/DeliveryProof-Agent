# Optional for DeepSeek Flash Agent and image/PDF extraction.
DEEPSEEK_API_KEY=

# Set these as process environment variables when deploying the multi-party portal.
# Public deployment requires HTTPS, identity review, and an administrator password.
DELIVERYPROOF_ADMIN_PASSWORD=
DELIVERYPROOF_PUBLIC_URL=

# Optional outbound email. Disabled unless explicitly set to 1.
DELIVERYPROOF_AUTO_EMAIL=0
DELIVERYPROOF_SMTP_HOST=
DELIVERYPROOF_SMTP_PORT=465
DELIVERYPROOF_SMTP_USER=
DELIVERYPROOF_SMTP_PASSWORD=
DELIVERYPROOF_SMTP_FROM=

# Optional voice escalation after 72 hours. Disabled unless explicitly set to 1.
DELIVERYPROOF_AUTO_CALL=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
